# Frontend runtime
# Leave VITE_API_URL empty when the frontend and backend share the same origin
# and the reverse proxy forwards /api requests to the backend.
VITE_API_URL=

# Local fallback port used only when the frontend runs on localhost without VITE_API_URL.
VITE_API_PORT=5000

# Optional dev-only proxy target for Vite. If omitted, Vite uses VITE_API_URL
# or falls back to http://localhost:${VITE_API_PORT}.
VITE_DEV_PROXY_TARGET=

# Frontend request timeout in milliseconds. Increase for platforms with cold starts.
VITE_API_TIMEOUT_MS=30000

# Network retry behavior for transient failures (timeouts, temporary backend wake-up).
VITE_API_RETRY_MAX=2
VITE_API_RETRY_DELAY_MS=1200
