{
  "name": "digital-task-evaluation-portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/kill-stale-dev.mjs && node scripts/dev-all.mjs",
    "frontend:dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "backend:dev": "npm --prefix backend run dev",
    "backend:start": "npm --prefix backend start",
    "backend:seed": "npm --prefix backend run seed",
    "backend:doctor": "npm --prefix backend run doctor",
    "install:all": "npm install && npm --prefix backend install",
    "verify:deploy": "npm run build && npm run backend:doctor"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "dependencies": {
    "axios": "^1.13.5",
    "lucide-react": "^0.563.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
