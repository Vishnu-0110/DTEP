# Backend runtime
NODE_ENV=development
PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
ALLOWED_ORIGINS=http://localhost:3000
# Use persistent disk in production (example: /var/data/dtep-uploads on Render)
UPLOAD_DIR=./uploads
# Optional: set true to skip MongoDB backup copy of uploaded files
DISABLE_DB_FILE_BACKUP=false

# MongoDB Atlas
# Replace placeholders with your Atlas user, password, and cluster hostname.
# If password has special chars, URL-encode it first.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/myDatabase?retryWrites=true&w=majority&appName=task-system
# Optional override if db name is not in URI
MONGODB_DB_NAME=myDatabase

# Google Gemini AI
GEMINI_API_KEY=<your_gemini_api_key>
